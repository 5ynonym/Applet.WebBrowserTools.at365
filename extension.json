{
    "apiVersion":  1,
    "id":  "at365.web-browser-tools",
    "name":  "Applet.WebBrowserTools.at365",
    "displayName":  "WebBrowserTools.at365",
    "version":  "0.1.0",
    "minimumHostVersion":  "0.6.0",
    "runtime":  "dotnet",
    "entry":  "Applet.WebBrowserTools.at365.dll",
    "type":  "Applets.WebBrowserTools.WebBrowserToolsApplet",
    "description":  "Chromiumブラウザのタブ・履歴・再読み込み・ウィンドウ操作。",
    "capabilities":  [
                         "ui",
                         "settings",
                         "dynamic-commands"
                     ],
    "commands":  [
                     {
                         "id":  "at365.web-browser-tools.close-tab",
                         "title":  "タブを閉じる"
                     },
                     {
                         "id":  "at365.web-browser-tools.back",
                         "title":  "戻る"
                     },
                     {
                         "id":  "at365.web-browser-tools.forward",
                         "title":  "進む"
                     },
                     {
                         "id":  "at365.web-browser-tools.reload",
                         "title":  "リロード"
                     },
                     {
                         "id":  "at365.web-browser-tools.super-reload",
                         "title":  "スーパーリロード"
                     },
                     {
                         "id":  "at365.web-browser-tools.toggle-fullscreen",
                         "title":  "全画面を切り替え"
                     },
                     {
                         "id":  "at365.web-browser-tools.new-tab",
                         "title":  "新しいタブを開く"
                     },
                     {
                         "id":  "at365.web-browser-tools.new-window",
                         "title":  "新しいウィンドウを開く"
                     },
                     {
                         "id":  "at365.web-browser-tools.previous-tab",
                         "title":  "前のタブへ"
                     },
                     {
                         "id":  "at365.web-browser-tools.next-tab",
                         "title":  "次のタブへ"
                     },
                     {
                         "id":  "at365.web-browser-tools.restore-tab",
                         "title":  "閉じたタブを復元"
                     }
                 ],
    "settings":  [
                     {
                         "title":  "対象ブラウザのプロセス名",
                         "key":  "browserProcesses",
                         "default":  "chrome, msedge, brave, vivaldi, opera, chromium, thorium",
                         "description":  "カンマ区切り。最前面のChromiumウィンドウに限って操作します。",
                         "type":  "string"
                     },
                     {
                         "title":  "タブを閉じる：送信キー",
                         "key":  "keys.close-tab",
                         "default":  "Ctrl+F4",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "スーパーリロード：送信キー",
                         "key":  "keys.super-reload",
                         "default":  "Ctrl+F5",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "全画面を切り替え：送信キー",
                         "key":  "keys.toggle-fullscreen",
                         "default":  "F11",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "新しいタブを開く：送信キー",
                         "key":  "keys.new-tab",
                         "default":  "Ctrl+T",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "新しいウィンドウを開く：送信キー",
                         "key":  "keys.new-window",
                         "default":  "Ctrl+N",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "前のタブへ：送信キー",
                         "key":  "keys.previous-tab",
                         "default":  "Ctrl+Shift+Tab",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "次のタブへ：送信キー",
                         "key":  "keys.next-tab",
                         "default":  "Ctrl+Tab",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     },
                     {
                         "title":  "閉じたタブを復元：送信キー",
                         "key":  "keys.restore-tab",
                         "default":  "Ctrl+Shift+T",
                         "description":  "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
                         "type":  "string"
                     }
                 ]
}