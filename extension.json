{
  "apiVersion": 1,
  "id": "at365.web-browser-tools",
  "name": "Applet.WebBrowserTools.at365",
  "displayName": "WebBrowserTools.at365",
  "version": "0.3.0",
  "minimumHostVersion": "0.26.0",
  "runtime": "native",
  "entry": "Applet.WebBrowserTools.at365.exe",
  "description": "既定でChromiumブラウザを対象にする操作と、右ボタンによる上下左右のマウスジェスチャー。",
  "capabilities": [
    "ui",
    "settings",
    "dynamic-commands"
  ],
  "commands": [
    {
      "id": "at365.web-browser-tools.close-tab",
      "title": "タブを閉じる"
    },
    {
      "id": "at365.web-browser-tools.back",
      "title": "戻る"
    },
    {
      "id": "at365.web-browser-tools.forward",
      "title": "進む"
    },
    {
      "id": "at365.web-browser-tools.reload",
      "title": "リロード"
    },
    {
      "id": "at365.web-browser-tools.super-reload",
      "title": "スーパーリロード"
    },
    {
      "id": "at365.web-browser-tools.toggle-fullscreen",
      "title": "全画面を切り替え"
    },
    {
      "id": "at365.web-browser-tools.new-tab",
      "title": "新しいタブを開く"
    },
    {
      "id": "at365.web-browser-tools.new-window",
      "title": "新しいウィンドウを開く"
    },
    {
      "id": "at365.web-browser-tools.previous-tab",
      "title": "前のタブへ"
    },
    {
      "id": "at365.web-browser-tools.next-tab",
      "title": "次のタブへ"
    },
    {
      "id": "at365.web-browser-tools.restore-tab",
      "title": "閉じたタブを復元"
    }
  ],
  "settings": [
    {
      "title": "タブを閉じる：送信キー",
      "key": "keys.close-tab",
      "default": "Ctrl+F4",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "スーパーリロード：送信キー",
      "key": "keys.super-reload",
      "default": "Ctrl+F5",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "全画面を切り替え：送信キー",
      "key": "keys.toggle-fullscreen",
      "default": "F11",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "新しいタブを開く：送信キー",
      "key": "keys.new-tab",
      "default": "Ctrl+T",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "新しいウィンドウを開く：送信キー",
      "key": "keys.new-window",
      "default": "Ctrl+N",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "前のタブへ：送信キー",
      "key": "keys.previous-tab",
      "default": "Ctrl+Shift+Tab",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "次のタブへ：送信キー",
      "key": "keys.next-tab",
      "default": "Ctrl+Tab",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    },
    {
      "title": "閉じたタブを復元：送信キー",
      "key": "keys.restore-tab",
      "default": "Ctrl+Shift+T",
      "description": "例: Ctrl+Shift+T、Alt+Left、F11。保存後すぐ反映されます。",
      "type": "string"
    }
  ],
  "defaultGestureBindings": [
    {
      "command": "at365.web-browser-tools.restore-tab",
      "id": "default.web-browser-tools.move-up",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "move-up"
    },
    {
      "command": "at365.web-browser-tools.reload",
      "id": "default.web-browser-tools.move-down",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "move-down"
    },
    {
      "command": "at365.web-browser-tools.back",
      "id": "default.web-browser-tools.move-left",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "move-left"
    },
    {
      "command": "at365.web-browser-tools.forward",
      "id": "default.web-browser-tools.move-right",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "move-right"
    },
    {
      "command": "at365.web-browser-tools.close-tab",
      "id": "default.web-browser-tools.click-left",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "click-left"
    },
    {
      "command": "at365.web-browser-tools.new-tab",
      "id": "default.web-browser-tools.click-middle",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "click-middle"
    },
    {
      "command": "at365.web-browser-tools.previous-tab",
      "id": "default.web-browser-tools.wheel-up",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "wheel-up"
    },
    {
      "command": "at365.web-browser-tools.next-tab",
      "id": "default.web-browser-tools.wheel-down",
      "enabled": true,
      "when": {
        "appletIds": [],
        "processes": [],
        "scope": "browser"
      },
      "gesture": "wheel-down"
    }
  ]
}
